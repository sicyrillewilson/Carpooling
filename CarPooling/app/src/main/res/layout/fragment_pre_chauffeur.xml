<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="20dp">
            <TextView
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_marginHorizontal="10dp"
                android:id="@+id/fragment_pre_chauffeur_trajet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mes Trajets"
                android:fontFamily="@font/itc_eras_bold"
                android:textSize="20dp"
                style="design"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_margin="10dp"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_marginHorizontal="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pas encore chauffeur"
                android:textSize="17sp"
                style="design"/>

            <TextView
                android:layout_margin="10dp"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_marginHorizontal="10dp"
                android:id="@+id/fragment_pre_chauffeur_devenir_chauffeur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Voulez-vous devenir un chauffeur ?"
                android:fontFamily="@font/itc_eras_bold"
                android:textSize="17sp"
                style="design"
                android:drawableEnd="@drawable/ic_car_side_resized"/>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>