<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Liste des messages -->
        <ListView
            android:id="@+id/chat_layout_lv_messages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp" />

        <!-- Zone de saisie et envoi de message -->
        <LinearLayout
            android:gravity="center"
            android:layout_margin="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="@drawable/contour_circulaire_message">


            <ImageView
                android:layout_margin="5dp"
                android:id="@+id/chat_layout_chat"
                android:layout_width="35dp"
                android:layout_height="30dp"
                android:background="@drawable/chat"/>

            <EditText
                android:paddingHorizontal="30dp"
                android:id="@+id/chat_layout_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:hint="Message.."
                android:inputType="text"
                android:background="@color/transaprent"/>

            <ImageView
                android:layout_margin="5dp"
                android:id="@+id/chat_layout__send"
                android:layout_width="35dp"
                android:layout_height="30dp"
                android:background="@drawable/send"/>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>