<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:gravity="center"
            android:layout_marginVertical="15dp"
            android:layout_marginStart="0dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <ImageView
                android:id="@+id/chat_layout_retour"
                android:backgroundTint="@color/black"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/angle_small_left"/>

            <TextView
                android:textStyle="bold"
                android:id="@+id/chat_layout_nom_chauffeur"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/transaprent"
                android:gravity="center|start"
                android:minHeight="48dp"
                android:paddingHorizontal="10dp"
                android:text="Prenom du chauffeur"
                android:textColor="@color/black"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Liste des messages -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_layout_lv_messages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:clipToPadding="false"
            android:scrollbars="vertical"/>

        <!-- Zone de saisie et envoi de message -->
        <LinearLayout
            android:gravity="center"
            android:layout_margin="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:background="@drawable/contour_circulaire_message">


            <ImageView
                android:layout_margin="5dp"
                android:id="@+id/chat_layout_chat"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/chat"/>

            <EditText
                android:paddingHorizontal="10dp"
                android:id="@+id/chat_layout_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:hint="Message.."
                android:background="@color/transaprent"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:scrollbars="vertical"
                android:gravity="center_vertical"/>

            <ImageView
                android:layout_margin="5dp"
                android:id="@+id/chat_layout_send"
                android:layout_width="25dp"
                android:layout_height="20dp"
                android:background="@drawable/send"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>