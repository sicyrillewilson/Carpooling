<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="30dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginVertical="10dp">
                <ImageView
                    android:id="@+id/sign_up_lock_icon"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/lock"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp">
                <EditText
                    android:padding="8dp"
                    android:background="@drawable/contour_circulaire"
                    android:id="@+id/sign_up_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:hint="Email..."
                    android:inputType="textEmailAddress"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginVertical="10dp"
                android:background="@drawable/contour_circulaire">

                <EditText
                    android:layout_weight="0.8"
                    android:id="@+id/sign_up_mot_de_passe"
                    android:layout_width="wrap_content"
                    android:background="@color/transaprent"
                    android:layout_height="wrap_content"
                    android:hint="Mot de passe.."
                    android:inputType="textPassword"
                    android:minHeight="48dp"
                    android:padding="8dp" />

                <ImageView
                    android:layout_weight="0.05"
                    android:layout_gravity="center|end"
                    android:id="@+id/password_toggle"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_margin="8dp"
                    android:src="@drawable/star"
                    android:contentDescription="password visibility"/>

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp"
                android:background="@drawable/contour_circulaire"
                android:orientation="horizontal">
                <EditText
                    android:layout_weight="0.8"
                    android:padding="8dp"
                    android:background="@color/transaprent"
                    android:id="@+id/sign_up_confirmer_mot_de_passe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:hint="Confirmer le mot de passe..."
                    android:inputType="textPassword"/>

                <ImageView
                    android:layout_weight="0.05"
                    android:layout_gravity="center|end"
                    android:id="@+id/password_toggle2"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_margin="8dp"
                    android:src="@drawable/star"
                    android:contentDescription="password visibility"/>

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp">
                <Button
                    android:background="@drawable/contour_circulaire"
                    android:fontFamily="@font/itc_eras_bold"
                    android:id="@+id/sign_up_valider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:textSize="20dp"
                    android:text="Valider"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp">
                <TextView
                    android:id="@+id/sign_up_continue_avec"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Ou continuer avec"
                    android:gravity="center"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginVertical="10dp">
                <ImageView
                    android:id="@+id/sign_up_continue_avec_google"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/google_2"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginHorizontal="30dp">
            <TextView
                android:id="@+id/sign_up_deja_un_compte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginHorizontal="3dp"
                android:gravity="center"
                android:text="Vous avez déjà un compte ? " />
            <TextView
                android:fontFamily="@font/itc_eras_bold"
                android:id="@+id/sign_up_se_connecter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginHorizontal="3dp"
                android:gravity="center"
                android:text="Se connecter"
                android:textColor="@color/boutonColor1"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>