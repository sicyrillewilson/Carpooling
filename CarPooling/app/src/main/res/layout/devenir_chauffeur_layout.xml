<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:gravity="center"
            android:layout_marginVertical="15dp"
            android:layout_marginStart="0dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <ImageView
                android:id="@+id/devenir_chauffeur_retour"
                android:backgroundTint="@color/black"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/angle_small_left"/>

            <TextView
                android:textColor="@color/black"
                android:gravity="center|start"
                android:paddingHorizontal="10dp"
                android:id="@+id/devenir_chauffeur_nouveau_chauffeur"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:text="Nouveau chauffeur"
                android:textSize="15sp"
                android:background="@color/transaprent"/>

        </LinearLayout>

        <LinearLayout
            android:gravity="center"
            android:layout_marginVertical="15dp"
            android:layout_marginStart="0dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_marginVertical="10dp"
                android:layout_marginHorizontal="20dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Veillez remplir le formulaire \nsuivant pour créer votre compte chauffeur"
                android:textSize="17sp"/>

            <TextView
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="20dp"
                android:fontFamily="@font/itc_eras_bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Formulaire"
                android:textSize="17sp"/>

            <LinearLayout
                android:layout_marginVertical="10dp"
                android:layout_marginHorizontal="20dp"
                android:padding="5dp"
                android:id="@+id/devenir_chauffeur_formulaire_zone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_marginVertical="5dp"
                    android:id="@+id/devenir_chauffeur_numero_lay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="5dp">

                    <TextView
                        android:textColor="@color/black"
                        android:textSize="15.5sp"
                        android:textStyle="bold"
                        android:layout_weight="0.4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Numero : "
                        android:inputType="number"/>

                    <EditText
                        android:layout_weight="0.15"
                        android:padding="8dp"
                        android:background="@drawable/contour_circulaire"
                        android:id="@+id/devenir_chauffeur_numero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:hint="Votre numero..."/>

                </LinearLayout>

                <LinearLayout
                    android:layout_marginVertical="5dp"
                    android:id="@+id/devenir_chauffeur_matricule_lay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="5dp">

                    <TextView
                        android:textColor="@color/black"
                        android:textSize="15.5sp"
                        android:textStyle="bold"
                        android:layout_weight="0.4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Matricule : "
                        android:inputType="text"/>

                    <EditText
                        android:layout_weight="0.15"
                        android:padding="8dp"
                        android:background="@drawable/contour_circulaire"
                        android:id="@+id/devenir_chauffeur_matricule"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:hint="Matricule de la voiture..."/>

                </LinearLayout>

                <LinearLayout
                    android:layout_marginVertical="10dp"
                    android:gravity="center"
                    android:id="@+id/devenir_chauffeur_bouton_lay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="5dp">

                    <TextView
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/annuler_contour_circulaire"
                        android:fontFamily="@font/itc_eras_bold"
                        android:id="@+id/devenir_chauffeur_annuler"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:textSize="15sp"
                        android:text="Annuler"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/creer_contour_circulaire"
                        android:fontFamily="@font/itc_eras_bold"
                        android:id="@+id/devenir_chauffeur_creer"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:textSize="15sp"
                        android:text="Créer"
                        android:clickable="true"
                        android:focusable="true"/>

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_marginVertical="30dp"
                android:layout_marginHorizontal="20dp"
                android:textColor="@color/black"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Accéder à mon espace chauffeur ?  "
                android:fontFamily="@font/itc_eras_bold"
                android:textSize="17sp"
                style="design"
                android:drawableEnd="@drawable/ic_car_side_resized"/>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>