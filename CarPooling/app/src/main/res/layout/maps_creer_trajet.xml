<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/maps_creer_trajet_id"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:name = "com.google.android.gms.maps.SupportMapFragment"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginVertical="10dp"
        android:layout_marginHorizontal="20dp"
        android:id="@+id/maps_creer_trajet_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <de.hdodenhof.circleimageview.CircleImageView
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/maps_creer_trajet_valider"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            android:layout_margin="5dp"
            android:src="@drawable/close"/>

        <de.hdodenhof.circleimageview.CircleImageView
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/maps_creer_trajet_annuler"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            android:layout_margin="5dp"
            android:src="@drawable/check"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        app:layout_constraintTop_toBottomOf="@id/maps_creer_trajet_navigation"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginVertical="10dp"
        android:layout_marginHorizontal="20dp"
        android:padding="10dp"
        android:id="@+id/maps_creer_trajet_formulaire_zone_haut"
        android:background="@drawable/contour_circulaire_maps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_marginVertical="5dp"
            android:id="@+id/maps_creer_trajet_destination_lay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="5dp">

            <TextView
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_weight="0.24"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Destination : " />

            <EditText
                android:layout_weight="0.15"
                android:padding="8dp"
                android:background="@drawable/contour_circulaire"
                android:id="@+id/maps_creer_trajet_destination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="Destination..."/>

        </LinearLayout>

        <LinearLayout
            android:layout_marginVertical="5dp"
            android:id="@+id/maps_creer_trajet_lieu_depart_lay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="5dp">

            <TextView
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_weight="0.24"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lieu de départ : " />

            <EditText
                android:layout_weight="0.15"
                android:padding="8dp"
                android:background="@drawable/contour_circulaire"
                android:id="@+id/maps_creer_trajet_lieu_depart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="Lieu de départ..."/>

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginVertical="10dp"
        android:layout_marginHorizontal="20dp"
        android:padding="10dp"
        android:id="@+id/maps_creer_trajet_formulaire_zone_bas"
        android:background="@drawable/contour_circulaire_maps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


        <LinearLayout
            android:layout_weight="0.2"
            android:layout_marginVertical="5dp"
            android:layout_marginHorizontal="5dp"
            android:id="@+id/maps_creer_trajet_heure_depart_lay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="5dp">

            <EditText
                android:layout_weight="0.15"
                android:padding="8dp"
                android:background="@drawable/contour_circulaire"
                android:id="@+id/maps_creer_trajet_heure_depart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="Heure de départ..."/>

        </LinearLayout>

        <LinearLayout
            android:layout_weight="1"
            android:layout_marginVertical="5dp"
            android:layout_marginHorizontal="5dp"
            android:id="@+id/maps_creer_trajet_prix_lay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="5dp">

            <EditText
                android:layout_weight="0.18"
                android:padding="8dp"
                android:background="@drawable/contour_circulaire"
                android:id="@+id/maps_creer_trajet_prix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="Prix..."/>

            <TextView
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:layout_weight="0.31"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="fcfa" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>